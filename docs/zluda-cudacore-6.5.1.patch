diff -ruN a/src/compiler/zluda_ptx.jl b/src/compiler/zluda_ptx.jl
--- a/src/compiler/zluda_ptx.jl	1970-01-01 01:00:00.000000000 +0100
+++ b/src/compiler/zluda_ptx.jl	2026-11-13 21:04:44.216671830 +0100
@@ -0,0 +1,77 @@
+# ZLUDA PATCH (not part of CUDA.jl): textual fix-ups of the PTX that LLVM generates, for
+# constructs that the PTX compiler of ZLUDA v7-preview.21 does not handle:
+#  1. A non-kernel `.func` whose body has no `ret` (Julia's `.noreturn` exception helpers end
+#     in `trap;`) makes ZLUDA panic and abort the process
+#     (ptx/src/pass/instruction_mode_to_global_mode/mod.rs:917, `functions_rets.get(name).unwrap()`).
+#     An unreachable `ret;` after the `trap;` does not help, so the last `trap;` of such a
+#     function is replaced by `ret;`. With the reduced exception runtime of this patch
+#     (src/device/runtime.jl) a thread that throws therefore keeps running after the status
+#     flag is set; the host still raises a KernelException after the kernel.
+#  2. `fence.sc.gpu;` / `fence.sc.sys;` are "Unrecognized statement"s: dropped.
+#  3. `isspacep.local %p, %rd;` is an "Unrecognized statement": replaced by a comparison that
+#     is always false (i.e. "the pointer is not in local memory").
+#  4. A call without arguments, `call.uni f, ();`, is an "Unrecognized statement": rewritten
+#     to `call.uni f;`.
+#  5. A function (also a kernel `.entry`) whose last instruction is a call to a noreturn
+#     helper falls off its end, and ZLUDA then fails the module with CUDA_ERROR_UNKNOWN: a
+#     `bra.uni` to a label put in front of the function's `ret;` is appended (ZLUDA wants a
+#     single `ret` per function), or a `ret;` if it has none.
+function zluda_fix_ptx(asm::String)
+    out = String[]
+    in_func = false; in_body = false; ret_idx = 0; last_trap = 0; last_instr = ""; nlabel = 0
+    for line in split(asm, '\n')
+        s = strip(line)
+        if startswith(s, "fence.")
+            continue
+        end
+        m = match(r"^(\s*)isspacep\.local\s+(%p\d+),\s*(%rd\d+);", line)
+        if m !== nothing
+            line = "$(m[1])setp.ne.b64 \t$(m[2]), $(m[3]), $(m[3]);"
+        end
+        m = match(r"^(\s*call(?:\.uni)?\s+)([^,\s]+),\s*\(\s*\);", line)
+        if m !== nothing
+            line = "$(m[1])$(m[2]);"
+        end
+        if !in_func && occursin(r"^(\.visible |\.weak |\.extern )?\.(func|entry)\b", line)
+            in_func = true; in_body = false; ret_idx = 0; last_trap = 0; last_instr = ""
+        end
+        if in_func
+            if !in_body
+                if line == "{"
+                    in_body = true
+                elseif line == ";" || (endswith(line, ";") && !startswith(line, "\t"))
+                    in_func = false   # declaration only
+                end
+            elseif startswith(line, "}")
+                if ret_idx == 0 && last_trap > 0
+                    out[last_trap] = "\tret;"
+                    ret_idx = last_trap
+                    last_instr == "trap;" && (last_instr = "ret;")
+                end
+                if !(startswith(last_instr, "ret;") || startswith(last_instr, "bra.uni") ||
+                     startswith(last_instr, "bra ") || startswith(last_instr, "bra\t") ||
+                     startswith(last_instr, "trap;") || startswith(last_instr, "exit;"))
+                    if ret_idx == 0
+                        push!(out, "\tret;")
+                    else
+                        nlabel += 1
+                        label = "\$L__zluda_ret_$nlabel"
+                        push!(out, "\tbra.uni \t$label;")
+                        insert!(out, ret_idx, "$label:")
+                    end
+                end
+                in_func = false
+            else
+                # an instruction: not a label, comment, directive or brace of a call sequence
+                if !isempty(s) && !startswith(s, "//") && !startswith(s, ".") &&
+                   !startswith(s, "{") && !startswith(s, "}") && !occursin(r"^[\$\w]+:", s)
+                    last_instr = s
+                    startswith(s, "ret;") && ret_idx == 0 && (ret_idx = length(out) + 1)
+                    startswith(s, "trap;") && (last_trap = length(out) + 1)
+                end
+            end
+        end
+        push!(out, String(line))
+    end
+    return join(out, '\n')
+end
